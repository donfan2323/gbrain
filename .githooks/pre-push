#!/bin/sh
# git-governance: pre-push hook
#
# Universal Git Governance — cross-repo rollout, ported from
# /Users/lab/.hermes/hermes-agent. Repo-specific values (upstream remote
# name, protected branch patterns) come from .git-governance/profile.conf.
#
# 1. Blocks any push whose destination is the upstream remote named in the
#    profile (by remote name or by URL), when the profile marks it
#    third-party. This duplicates the upstream remote's pushurl being
#    disabled — a second, independent layer that doesn't depend on that
#    config surviving.
# 2. Blocks force-pushes (non-fast-forward) to any protected branch, on any
#    remote. Non-protected branches (this repo's phase9b-* verification
#    snapshots, feature work, etc.) are unaffected.
#
# Can and does reject the push outright (unlike reference-transaction) — a
# non-zero exit here stops it before any network I/O. Like any client-side
# hook, it can be skipped with `git push --no-verify` — see
# docs/GIT_GOVERNANCE.md for why that's a documented limitation, not a bug.

remote_name="$1"
remote_url="$2"

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
profile="$repo_root/.git-governance/profile.conf"
[ -f "$profile" ] || exit 0
# shellcheck disable=SC1090
. "$profile"

upstream_remote="${UPSTREAM_REMOTE:-origin}"
upstream_is_thirdparty="${UPSTREAM_IS_THIRDPARTY:-false}"
zero="0000000000000000000000000000000000000000"
blocked=0

is_protected() {
    ref="$1"
    for glob in ${PROTECTED_BRANCH_GLOBS:-}; do
        case "$ref" in
            $glob) return 0 ;;
        esac
    done
    return 1
}

if [ "$upstream_is_thirdparty" = "true" ]; then
    upstream_url=$(git config --get "remote.$upstream_remote.url" 2>/dev/null)
    if [ "$remote_name" = "$upstream_remote" ] || { [ -n "$upstream_url" ] && [ "$remote_url" = "$upstream_url" ]; }; then
        echo "git-governance: push to '$remote_name' ($remote_url) is blocked — that is the third-party upstream." >&2
        echo "  This repo's policy is fetch-only from $upstream_remote. Push local work with:" >&2
        echo "    git push ${WRITABLE_REMOTE:-fork} <branch>" >&2
        exit 1
    fi
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    is_protected "$remote_ref" || continue
    [ "$remote_sha" = "$zero" ] && continue
    [ "$local_sha" = "$zero" ] && continue

    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "git-governance: refusing force-push to protected ref '$remote_ref' on '$remote_name'." >&2
        echo "  remote tip $remote_sha is not an ancestor of local $local_sha." >&2
        blocked=1
    fi
done

[ "$blocked" = "1" ] && exit 1
exit 0
